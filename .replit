modules = ["nodejs-20", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Iqbal CV Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Iqbal CV Bot Python"

[[workflows.workflow]]
name = "Iqbal CV Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Iqbal CV Bot Python"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd python_src && pip install -q python-telegram-bot python-dotenv requests openpyxl && python3 main.py"

[workflows.workflow.metadata]
outputType = "console"

